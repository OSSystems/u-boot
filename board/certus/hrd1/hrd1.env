fdt_addr_r=0x18000000
fdtfile=imx6dl-hrd1.dtb
loadaddr=0x12000000
bootcmd=run mmcboot
mmcargs=setenv bootargs console=ttymxc0,115200 root=${mmcroot} rootfstype=ext4 rw rootwait cma=256M quiet
mmcboot=run mmcargs; load mmc 0:${mmcpart} ${loadaddr} boot/zImage; load mmc 0:${mmcpart} ${fdt_addr_r} boot/${fdtfile}; bootz ${loadaddr} - ${fdt_addr_r}
mmcpart=2
mmcroot=/dev/mmcblk0p2


/dts-v1/;

#include <dt-bindings/clock/imx6qdl-clock.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "imx6dl.dtsi"

/ {
	model = "Humly i.MX6 DualLite HRD1 Board";
	compatible = "humly,imx6dl-hrd1", "fsl,imx6dl";

	chosen {
		stdout-path = &uart1;
	};

	aliases {
		mmc0 = &usdhc4;
		mmc1 = &usdhc2;
	};

	memory: memory@10000000 {
		device_type = "memory";
		reg = <0x10000000 0x80000000>;
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			label = "green";
			pwms = <&pwm2 0 5000000 0>;
			max-brightness = <255>;
		};

		led-1 {
			label = "red";
			pwms = <&pwm3 0 5000000 0>;
			max-brightness = <255>;
		};

		led-2 {
			label = "blue";
			pwms = <&pwm4 0 5000000 0>;
			max-brightness = <255>;
		};
	};

	reg_usb_otg_vbus: regulator-usb-otg-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_otg_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio3 22 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&swbst_reg>;
	};

	reg_usb_h1_vbus: regulator-usb-h1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_h1_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio1 29 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&swbst_reg>;
	};

	egalax_pwr_on: regulator-egalax-pwr-on {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio6 14 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_egalax_pwr_on>;
		regulator-name = "egalax_pwr_on";
	};

	lan_pwr_on: reguator-lan-pwr-on {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio1 0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lanpwr>;
		regulator-name = "lan_pwr_on";
		regulator-always-on;
		regulator-boot-on;
	};

	lvds_power: regulator-lvds-power {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio6 8 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lvds_power>;
		regulator-name = "lvds_power";
		regulator-always-on;
		regulator-boot-on;
	};

	reg_wifi: regulator-wifi {
		compatible = "regulator-fixed";
		gpio = <&gpio1 4 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wifi_reg>;
		regulator-name = "wifi_reg";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	reg_nfc: regulator-nfc {
		compatible = "regulator-fixed";
		gpio = <&gpio1 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-name = "nfc_reg";
		regulator-always-on;
		regulator-boot-on;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wl_reg_on>;
		post-power-on-delay-ms = <200>;
		/* WL_REG_ON pin goes through an inverter */
		reset-gpios = <&gpio7 12 GPIO_ACTIVE_HIGH>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio_keys>;

		button {
			label = "Power Button";
			gpios = <&gpio3 29 GPIO_ACTIVE_LOW>;
			wakeup-source;
			linux,code = <KEY_POWER>;
		};
	};

	backlight_lvds: backlight-lvds {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 100000 0>;
		brightness-levels = <0 4 8 16 32 64 128 255>;
		default-brightness-level = <7>;
		status = "okay";
	};

	panel {
		compatible = "hannstar,hsd100pxn1";
		backlight = <&backlight_lvds>;
		power-supply = <&lvds_power>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&lvds1_out>;
			};
		};
	};
};

&clks {
	assigned-clocks = <&clks IMX6QDL_CLK_LDB_DI0_SEL>,
			  <&clks IMX6QDL_CLK_LDB_DI1_SEL>;
	assigned-clock-parents = <&clks IMX6QDL_CLK_PLL2_PFD0_352M>,
				 <&clks IMX6QDL_CLK_PLL2_PFD0_352M>;
};

&ecspi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi1>;
	cs-gpios = <&gpio3 19 GPIO_ACTIVE_LOW>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <25000000>;


		partition@0 {
			label = "bootloader";
			reg = <0x0000000 0x100000>;
		};

		partition@100000 {
			label = "user";
			reg = <0x0100000 0x020000>;
		};
	};
};

&gpio1 {
	green-hog {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		line-name = "green-enable";
		output-high;
	};

	red-hog {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>;
		line-name = "red-enable";
		output-high;
	};

	blue-hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>;
		line-name = "blue-enable";
		output-high;
	};
};

&i2c1 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
	status = "okay";

        nfc@29 {
		compatible = "nxp,nxp-nci-i2c";
		reg = <0x29>;
		interrupt-parent = <&gpio5>;
		interrupts = <31 IRQ_TYPE_LEVEL_HIGH>;
		enable-gpios = <&gpio5 8 GPIO_ACTIVE_HIGH>;
	};
};

&i2c2 {
	clock-frequency = <100000>;
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_i2c2>;
	pinctrl-1 = <&pinctrl_i2c2_gpio>;
	scl-gpios = <&gpio4 12 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpio4 13 GPIO_ACTIVE_HIGH>;
	status = "okay";

	pmic@8 {
		compatible = "fsl,pfuze100";
		reg = <0x08>;

		regulators {
			sw1a_reg: sw1ab {
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1875000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <6250>;
			};

			sw1c_reg: sw1c {
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1875000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <6250>;
			};

			sw2_reg: sw2 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <6250>;
			};

			sw3a_reg: sw3a {
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1975000>;
				regulator-boot-on;
				regulator-always-on;
			};

			sw3b_reg: sw3b {
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1975000>;
				regulator-boot-on;
				regulator-always-on;
			};

			sw4_reg: sw4 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			swbst_reg: swbst {
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5150000>;
			};

			snvs_reg: vsnvs {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vref_reg: vrefddr {
				regulator-boot-on;
				regulator-always-on;
			};

			vgen1_reg: vgen1 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1550000>;
			};

			vgen2_reg: vgen2 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1550000>;
			};

			vgen3_reg: vgen3 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};

			vgen4_reg: vgen4 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			vgen5_reg: vgen5 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			vgen6_reg: vgen6 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};
		};
	};
};

&i2c3 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c3>;
	status = "okay";

	touchscreen@2a {
		compatible = "eeti,exc3000";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_i2c2_egalax_int>;
		reg = <0x2a>;
		interrupt-parent = <&gpio6>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
		vdd-supply = <&egalax_pwr_on>;
		touchscreen-size-x = <1024>;
		touchscreen-size-y = <768>;
		reset-gpios = <&gpio6 11 GPIO_ACTIVE_LOW>;
	};
};

&i2c4 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c4>;
	status = "okay";

	led-controller@39 {
		compatible = "onnn,ncp5623";
		reg = <0x39>;

		multi-led {
			color = <LED_COLOR_ID_RGB>;
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_GREEN>;
			};

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_RED>;
			};

			led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_BLUE>;
			};
		};
	};
};

&ldb {
	status = "okay";

	lvds-channel@1 {
		fsl,data-mapping = "spwg";
		fsl,data-width = <24>;
		status = "okay";

		port@4 {
			reg = <4>;

			lvds1_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&pwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm1>;
	status = "okay";
};

&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm2>;
	status = "okay";
};

&pwm3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm3>;
	status = "okay";
};

&pwm4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm4>;
	status = "okay";
};

&reg_arm {
	vin-supply = <&sw1a_reg>;
};

&reg_pu {
	in-supply = <&sw1c_reg>;
};

&reg_soc {
	vin-supply = <&sw1c_reg>;
};

&reg_vdd1p1 {
	vin-supply = <&vgen5_reg>;
};

&reg_vdd2p5 {
	vin-supply = <&vgen5_reg>;
};

&snvs_poweroff {
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	uart-has-rtscts;
	status = "okay";
};

/* Bluetooth */
&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm43438-bt";
		max-speed = <3000000>;
		shutdown-gpios = <&gpio4 11 GPIO_ACTIVE_LOW>;
	};
};

&usbh1 {
	vbus-supply = <&reg_usb_h1_vbus>;
	status = "okay";
};

&usbotg {
	vbus-supply = <&reg_usb_otg_vbus>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usbotg>;
	disable-over-current;
	status = "okay";
};

/* SDIO */
&usdhc2 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>;
	vmmc-supply = <&reg_wifi>;
	bus-width = <4>;
	non-removable;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	status = "okay";

	wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
	};
};

/* eMMC */
&usdhc4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc4>;
	bus-width = <8>;
	non-removable;
	no-1-8-v;
	status = "okay";
};

&wdog1 {
	status = "disabled";
};

&wdog2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdog>;
	fsl,ext-reset-output;
	status = "okay";
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	pinctrl_hog: hoggrp {
		fsl,pins = <
			MX6QDL_PAD_SD3_DAT4__GPIO7_IO01         0x1b0b0 // TP14
			MX6QDL_PAD_SD3_DAT5__GPIO7_IO00         0x1b0b0 // TP15
			MX6QDL_PAD_SD3_DAT6__GPIO6_IO18         0x1b0b0 // TP13
			MX6QDL_PAD_SD3_DAT7__GPIO6_IO17         0x1b0b0 // TP16
			MX6QDL_PAD_SD3_RST__GPIO7_IO08          0x1b0b0 // TP18
			MX6QDL_PAD_ENET_TXD1__GPIO1_IO29        0x1b0b0 // USB_H1_PWR_EN
			MX6QDL_PAD_ENET_CRS_DV__GPIO1_IO25      0x1b0b0 // RGMII_nRST
			MX6QDL_PAD_KEY_COL0__GPIO4_IO06         0x1b0b0 // BT_WAKUP_B
			MX6QDL_PAD_KEY_ROW0__GPIO4_IO07         0x1b0b0 // TP12
			MX6QDL_PAD_KEY_COL2__GPIO4_IO10         0x1b0b0 // LCD_STBYB
			MX6QDL_PAD_GPIO_2__GPIO1_IO02           0x1b0b0 // BT_HOST_WAKEUP_B
			MX6QDL_PAD_GPIO_5__GPIO1_IO05           0x1b0b0 // NFC_PWREN
			MX6QDL_PAD_GPIO_7__GPIO1_IO07           0x1b0b0 // LED_GREEN
			MX6QDL_PAD_GPIO_8__GPIO1_IO08           0x1b0b0 // LED_RED
			MX6QDL_PAD_GPIO_9__GPIO1_IO09           0x1b0b0 // LED_BLUE
			MX6QDL_PAD_GPIO_18__GPIO7_IO13          0x1b0b0 // PMIC_INT_B
			MX6QDL_PAD_GPIO_19__GPIO4_IO05          0x1b0b0 // SENSOR_INT
			MX6QDL_PAD_NANDF_CS0__GPIO6_IO11        0x1b0b0 // TOUCH_RST
			MX6QDL_PAD_NANDF_CS2__GPIO6_IO15        0x1b0b0 // TOUCH_MODE_SW
			MX6QDL_PAD_NANDF_RB0__GPIO6_IO10        0x1b0b0 // AUX_5V_EN
			MX6QDL_PAD_NANDF_D0__GPIO2_IO00         0x1b0b0 // SD3_CD_B
			MX6QDL_PAD_NANDF_D1__GPIO2_IO01         0x1b0b0 // SD3_WP
			MX6QDL_PAD_NANDF_D2__GPIO2_IO02         0x1b0b0 // SD2_CD_B
			MX6QDL_PAD_NANDF_D3__GPIO2_IO03         0x1b0b0 // SD2_WP
			MX6QDL_PAD_NANDF_D4__GPIO2_IO04         0x1b0b0 // TP51
			MX6QDL_PAD_NANDF_D5__GPIO2_IO05         0x1b0b0 // TP49
			MX6QDL_PAD_NANDF_D6__GPIO2_IO06         0x1b0b0 // TP19
			MX6QDL_PAD_NANDF_D7__GPIO2_IO07         0x1b0b0 // TP50
			MX6QDL_PAD_CSI0_DAT13__GPIO5_IO31       0x1b0b0 // NFC_IRQ
			MX6QDL_PAD_CSI0_DAT17__GPIO6_IO03       0x1b0b0 // NFC_FW_UG
			MX6QDL_PAD_CSI0_DAT19__GPIO6_IO05       0x1b0b0 // TP39
			MX6QDL_PAD_EIM_D22__GPIO3_IO22          0x1b0b0 // USB_OTG_PWR_EN
			MX6QDL_PAD_EIM_D30__USB_H1_OC           0x1b0b0 // USB_OTG_OC
			MX6QDL_PAD_EIM_EB3__GPIO2_IO31          0x1b0b0 // SENSOR_PWR_EN
			MX6QDL_PAD_DISP0_DAT18__GPIO5_IO12      0x1b0b0 // SPINOR_WP
			MX6QDL_PAD_DISP0_DAT14__GPIO5_IO08      0x1b0b0 // NFC_VEN
			MX6QDL_PAD_DISP0_DAT17__GPIO5_IO11      0x1b0b0 // BOARD_ID0
			MX6QDL_PAD_DISP0_DAT22__GPIO5_IO16      0x1b0b0 // BOARD_ID1
			MX6QDL_PAD_DISP0_DAT23__GPIO5_IO17      0x1b0b0 // BOARD_ID2
			MX6QDL_PAD_KEY_ROW2__GPIO4_IO11         0x1b0b0 // BT_RESET
		>;
	};

	pinctrl_ecspi1: ecspi1grp {
		fsl,pins = <
			MX6QDL_PAD_EIM_D16__ECSPI1_SCLK         0x100b1
			MX6QDL_PAD_EIM_D17__ECSPI1_MISO         0x100b1
			MX6QDL_PAD_EIM_D18__ECSPI1_MOSI         0x100b1
			MX6QDL_PAD_EIM_D19__GPIO3_IO19          0x100b1
		>;
	};

	pinctrl_gpio_keys: gpio_keysgrp {
		fsl,pins = <
			MX6QDL_PAD_EIM_D29__GPIO3_IO29 0x1b0b0
		>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			MX6QDL_PAD_CSI0_DAT8__I2C1_SDA		0x4001b8b1
			MX6QDL_PAD_CSI0_DAT9__I2C1_SCL		0x4001b8b1
			>;
	};

	pinctrl_i2c2: i2c2grp {
		fsl,pins = <
			MX6QDL_PAD_KEY_COL3__I2C2_SCL		0x4001b8b1
			MX6QDL_PAD_KEY_ROW3__I2C2_SDA		0x4001b8b1
			>;
	};

	pinctrl_i2c2_gpio: i2c2_gpio_grp {
		fsl,pins = <
			MX6QDL_PAD_KEY_COL3__GPIO4_IO12		0x1b8b0
			MX6QDL_PAD_KEY_ROW3__GPIO4_IO13		0x1b0b0
		>;
	};

	pinctrl_i2c2_egalax_int: i2c2egalaxintgrp {
		fsl,pins = <
			MX6QDL_PAD_NANDF_CLE__GPIO6_IO07        0x1b0b0
		>;
	};

	pinctrl_egalax_pwr_on: egalaxpwrgrp {
		fsl,pins = <
			MX6QDL_PAD_NANDF_CS1__GPIO6_IO14        0x1b0b0
		>;
	};

	pinctrl_i2c3: i2c3grp {
		fsl,pins = <
			MX6QDL_PAD_GPIO_3__I2C3_SCL		0x4001b8b1
			MX6QDL_PAD_GPIO_6__I2C3_SDA		0x4001b8b1
		>;
	};

	pinctrl_i2c4: i2c4grp {
		fsl,pins = <
			MX6QDL_PAD_NANDF_WP_B__I2C4_SCL         0x4001b8b1
			MX6QDL_PAD_NANDF_CS3__I2C4_SDA          0x4001b8b1
		>;
	};

	pinctrl_lvds_power: lvdspwrgrp {
		fsl,pins = <
			MX6QDL_PAD_NANDF_ALE__GPIO6_IO08        0x1b0b0
		>;
	};

	pinctrl_pwm1: pwm1grp {
		fsl,pins = <
			MX6QDL_PAD_SD1_DAT3__PWM1_OUT		0x1b0b1
		>;
	};

	pinctrl_pwm2: pwm2grp {
		fsl,pins = <
			MX6QDL_PAD_SD1_DAT2__PWM2_OUT           0x1b0b1
		>;
	};

	pinctrl_pwm3: pwm3grp {
		fsl,pins = <
			MX6QDL_PAD_SD1_DAT1__PWM3_OUT           0x1b0b1
		>;
	};

	pinctrl_pwm4: pwm4grp {
		fsl,pins = <
			MX6QDL_PAD_SD1_CMD__PWM4_OUT            0x1b0b1
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6QDL_PAD_CSI0_DAT10__UART1_TX_DATA	0x1b0b1
			MX6QDL_PAD_CSI0_DAT11__UART1_RX_DATA	0x1b0b1
		>;
	};

	pinctrl_uart3: uart3grp {
